# Avalon Monitor hub configuration. Copy to /etc/avalon-monitor/monitor.env (the systemd unit loads it; the installer
# copies this file there on first install) or to server/.env when running from the checkout. The file is chosen by
# AVM_ENV_FILE (default: .env in the working directory); real environment variables win over the file.
# One KEY=VALUE per line. Comments must be on their own line: text after a value is part of the value.
# Every setting is shown with its default; commented-out lines are the defaults.

# --- Listening ----------------------------------------------------------------
# Agents reach the hub over Tailscale, cloudflared on localhost. Keep the port closed on the LAN (ufw).
AVM_BIND_HOST=0.0.0.0
AVM_BIND_PORT=8787
# SQLite file. Code default is data/monitor.db (relative to the working directory, for development).
AVM_DB_PATH=/var/lib/avalon-monitor/monitor.db
# debug | info | warning | error
AVM_LOG_LEVEL=info

# --- Cloudflare Access (Zero Trust) ---------------------------------------------
# Needed to publish the dashboard through the tunnel, and for any change from the dashboard. See docs/CLOUDFLARE.md.
# Team domain: Zero Trust dashboard -> Settings -> Custom Pages -> "Team domain".
AVM_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag: Access -> Applications -> your app -> Overview.
AVM_ACCESS_AUD=
# Public dashboard URL, e.g. https://monitor.example.com. Its host is on the Host allowlist, read-only viewers are
# pointed there to make changes, and the UI shows it.
AVM_PUBLIC_URL=

# --- Who may view and who may change (docs/SECURITY.md) ---------------------------
# Direct (non-Cloudflare) requests from these CIDRs may VIEW without an Access login. Default: loopback + Tailscale.
#AVM_TRUSTED_NETWORKS=127.0.0.0/8,::1/128,100.64.0.0/10,fd7a:115c:a1e0::/48
# false = trusted networks need an Access login too (deploy-hub.sh's smoke test reads the dashboard from 127.0.0.1).
#AVM_ALLOW_TRUSTED_NO_AUTH=true
# Trusted-network viewers are read-only; every change needs a Cloudflare Access identity. true restores the old
# behaviour (anyone on a trusted network may change things, incl. prompts) - only for a hub without Access.
#AVM_TRUSTED_WRITE=false
# Access identities (emails, comma list) allowed to change things. Empty = anyone the Access policy admits.
#AVM_OPERATORS=you@example.com
# Extra Host header values to accept (DNS-rebinding guard), comma list. Always accepted: IP literals, localhost, this
# machine's hostname, <hostname>.<tailnet>.ts.net and the host of AVM_PUBLIC_URL.
#AVM_ALLOWED_HOSTS=
# This hub's tailnet (its MagicDNS suffix, `tailscale status --json` -> MagicDNSSuffix), e.g. tail1234.ts.net: only
# <hostname>.<it> is accepted as a MagicDNS name. Empty = detected once at startup; if that fails, any
# <hostname>.<tailnet>.ts.net is accepted and the hub logs a warning.
#AVM_TAILNET=
# Agents may push (ingest, tasks, results, self-update) only from these CIDRs, never through Cloudflare.
#AVM_INGEST_NETWORKS=127.0.0.0/8,::1/128,100.64.0.0/10,fd7a:115c:a1e0::/48
# Largest accepted agent sample / results document, in bytes (512 KiB).
#AVM_MAX_PAYLOAD_BYTES=524288

# --- Data lifecycle -------------------------------------------------------------
# Raw samples (7 days), 1-minute rollups, and when a host counts as offline.
#AVM_RETENTION_RAW_HOURS=168
#AVM_RETENTION_1M_DAYS=90
#AVM_OFFLINE_AFTER_SEC=30
# Finished tasks and prompt transcripts.
#AVM_RETENTION_TASKS_DAYS=60
# A failed / stalled / lost task alerts until acknowledged or for this many hours after it last changed (0 = no expiry).
#AVM_TASK_ALERT_HOURS=24

# --- Derived alerts -------------------------------------------------------------
# "gpu stalled": a job scope (AVM_WATCH_JOBS on the agent) active this long with the GPU never above this %.
#AVM_RULE_GPU_STALL_MINUTES=10
#AVM_RULE_GPU_STALL_PERCENT=5

# --- Agent auto-update ----------------------------------------------------------
# Offer the served agent script (and avm.py) to agents; they install it only when it carries a valid release
# signature (docs/RELEASING.md). false pauses updates fleet-wide.
#AVM_AGENT_AUTO_UPDATE=true
# Script to serve; avm.py and the *.sig files are read from the same directory. Default: agent/avalon_agent.py beside
# the server/ directory the hub runs from (/opt/avalon-monitor/agent/avalon_agent.py when installed).
#AVM_AGENT_SCRIPT=

# --- Content-Security-Policy ----------------------------------------------------
# Cloudflare Web Analytics injects a beacon script into proxied pages; it is allowed by default.
# Set to "" if you disable Web Analytics for the dashboard's hostname (recommended: Cloudflare dashboard ->
# Web Analytics -> site -> disable automatic setup), or add other origins space-separated.
#AVM_CSP_SCRIPT_EXTRA=https://static.cloudflareinsights.com
