# Avalon Monitor server configuration. Copy to /etc/avalon-monitor/monitor.env
# (the systemd unit loads it) or to server/.env when running from the checkout.

# Where to listen. Agents reach this over Tailscale; cloudflared reaches it on localhost.
AVM_BIND_HOST=0.0.0.0
AVM_BIND_PORT=8787

AVM_DB_PATH=/var/lib/avalon-monitor/monitor.db
AVM_LOG_LEVEL=info

# --- Cloudflare Access (Zero Trust) -----------------------------------------
# Required to expose the dashboard at monitor.avalontech.xyz. See docs/CLOUDFLARE.md.
# Team domain: Zero Trust dashboard -> Settings -> Custom Pages -> "Team domain".
AVM_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag: Access -> Applications -> your app -> Overview.
AVM_ACCESS_AUD=

# --- Network policy ---------------------------------------------------------
# Direct (non-Cloudflare) requests from these CIDRs may view the dashboard
# without an Access token. Default: loopback + Tailscale ranges.
#AVM_TRUSTED_NETWORKS=127.0.0.0/8,::1/128,100.64.0.0/10,fd7a:115c:a1e0::/48
#AVM_ALLOW_TRUSTED_NO_AUTH=true
# Agents may push metrics only from these CIDRs (never through Cloudflare).
#AVM_INGEST_NETWORKS=127.0.0.0/8,::1/128,100.64.0.0/10,fd7a:115c:a1e0::/48

# --- Data lifecycle ---------------------------------------------------------
#AVM_RETENTION_RAW_HOURS=168
#AVM_RETENTION_1M_DAYS=90
#AVM_OFFLINE_AFTER_SEC=30

# --- Derived alerts ---------------------------------------------------------
# "gpu stalled": a job scope (AVM_WATCH_JOBS on the agent) active this long with the GPU never above this %.
#AVM_RULE_GPU_STALL_MINUTES=10
#AVM_RULE_GPU_STALL_PERCENT=5
