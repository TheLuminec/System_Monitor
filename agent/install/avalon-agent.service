[Unit]
Description=Avalon Monitor agent
After=network-online.target tailscaled.service
Wants=network-online.target
# No config -> the unit is skipped cleanly instead of crash-looping (a bare --upgrade once left an empty /etc/avalon-agent).
ConditionPathExists=/etc/avalon-agent/agent.conf
# Give up after 10 failed starts in 5 min; the default (5 per 10 s) never trips at RestartSec=5.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/opt/avalon-agent/venv/bin/python /opt/avalon-agent/avalon_agent.py --config /etc/avalon-agent/agent.conf
Restart=always
RestartSec=5
# Exit 2 = bad/missing config: retrying cannot help.
RestartPreventExitStatus=2
Nice=10
# Runs as root so it can read all disks/sensors/process names; it writes nothing but its own script on self-update.
NoNewPrivileges=true
ProtectSystem=strict
# ProtectSystem=strict makes /opt read-only; self-update must replace avalon_agent.py/avm.py here (Fishseus failed with EROFS).
ReadWritePaths=/opt/avalon-agent
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
